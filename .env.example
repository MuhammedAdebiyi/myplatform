[TEMPLATE]
DATABASE_URL=postgresql://myplatform:myplatform@localhost:5432/myplatform
REDIS_URL=redis://localhost:6379
NODE_ENV=development
# Bounded Prisma connection pool (RULE 16): PROCESS_TYPE=api → 20, worker → 5;
# or set an explicit number via DATABASE_CONNECTION_LIMIT.
PROCESS_TYPE=api
# DATABASE_CONNECTION_LIMIT=20
# Slow-query log threshold in ms (RULE 18)
# DATABASE_SLOW_QUERY_MS=500

# ── GitHub App ──────────────────────────────────────────────
# Numeric App ID from the GitHub App settings page
GITHUB_APP_ID=
# PEM private key, base64-ENCODED (generate: base64 -i app-private-key.pem)
GITHUB_APP_PRIVATE_KEY_BASE64=
# Webhook secret — must match the webhook configuration in the GitHub App
GITHUB_WEBHOOK_SECRET=
# URL slug of the GitHub App (https://github.com/apps/<GITHUB_APP_SLUG>)
GITHUB_APP_SLUG=

# Web app origin (post-OAuth handoff redirects; also restricts CORS)
APP_URL=http://localhost:3000
# API origin — OAuth redirect_uri must point here (/auth/{google|github}/callback)
API_URL=http://localhost:4000
# Google OAuth (Google Cloud Console authorized redirect URI: {API_URL}/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth App (Authorization callback URL: {API_URL}/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# AES-256-GCM key for secret env vars at rest (base64-encoded 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENV_VAR_ENCRYPTION_KEY=
# NotificationHub (email delivery) — https://notificationhub.space
# API key from Settings → API Keys (nhub_live_...), org-scoped
NOTIFICATIONHUB_URL=https://api.notificationhub.space
NOTIFICATIONHUB_API_KEY=
